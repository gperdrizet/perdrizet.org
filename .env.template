# ============================================================
#  Environment Variables Template
#  Copy to .env and fill in values. Never commit .env.
# ============================================================

# --- LLM Backend ---
LLM_BASE_URL=http://localhost:8080/v1
LLM_MODEL=llama-3.1-8b
LLM_API_KEY=

# --- GitHub Agent ---
# Personal access token with read:user and public_repo scopes
# Used by tools/github-agent to fetch repo metadata
GITHUB_TOKEN=

# --- Admin Agent ---
# Admin edits local files in CONTENT_ROOT directly
CONTENT_ROOT=data/user
ADMIN_USER=admin
ADMIN_PASSWORD=                      # set a strong password; this protects the edit UI

# --- Deployment (direct from local machine) ---
# GATEKEEPER_HOST: public IP or hostname of the VPS
# GATEKEEPER_USER: SSH username
# Ensure your local SSH key is authorized on the VPS
GATEKEEPER_HOST=
GATEKEEPER_USER=
