# ============================================================
#  Environment Variables Template
#  Copy to .env and fill in values. Never commit .env.
# ============================================================

# --- LLM Backend ---
LLM_BASE_URL=http://localhost:8080/v1
LLM_MODEL=llama-3.1-8b
LLM_API_KEY=

# --- GitHub Agent ---
# Personal access token with read:user and public_repo scopes
# Used by tools/github-agent to fetch repo metadata
GITHUB_TOKEN=

# --- Admin Agent ---
# Set a strong admin key to protect the editing UI:
# openssl rand -base64 24
ADMIN_PASSWORD=

# --- Deployment (direct from local machine) ---
# VPS_HOST: public IP or hostname of the VPS
# VPS_USER: SSH username
# Ensure your local SSH key is authorized on the VPS
VPS_HOST=
VPS_USER=
