# ============================================================
#  Environment Variables Template
#  Copy to .env and fill in values. Never commit .env.
# ============================================================

# --- LLM Backend ---
LLM_BASE_URL=http://localhost:8080/v1
LLM_MODEL=llama-3.1-8b
LLM_API_KEY=

# --- GitHub Agent ---
# Personal access token with read:user and public_repo scopes
# Used by tools/github-agent to fetch repo metadata
GITHUB_TOKEN=

# --- Admin Agent ---
# Token needs contents:write on your repo (same PAT as above is fine)
GITHUB_REPO=owner/your-repo          # e.g. gperdrizet/perdrizet.org
GITHUB_BRANCH=dev                    # branch admin commits to; PR dev→main to deploy
ADMIN_USER=admin
ADMIN_PASSWORD=                      # set a strong password; this protects the edit UI

# --- Deployment (also set as GitHub Actions secrets) ---
# GATEKEEPER_HOST: public IP or hostname of the VPS
# GATEKEEPER_USER: SSH username
# GATEKEEPER_SSH_KEY: private key contents (no passphrase)
# These are set as GitHub repo secrets, not in .env
