---
import '../styles/global.css';
import { getAdminOnboardingUrl, getAdminUrl, getConfig, isOnboardingRequired } from '../lib/config';

interface Props {
  title?: string;
  description?: string;
  disableOnboardingRedirect?: boolean;
}

const config = getConfig();
const { personal, bio } = config;
const onboardingRequired = isOnboardingRequired();
const adminOnboardingUrl = getAdminOnboardingUrl(config);
const adminUrl = getAdminUrl(config);

const { title, description = bio.short, disableOnboardingRedirect = false } = Astro.props;
const pageTitle = title
  ? `${title} | ${personal.name}`
  : `${personal.name} | ${personal.tagline}`;

const nav = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
  { href: adminUrl, label: 'Admin', external: true },
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{pageTitle}</title>
  </head>
  <body class="bg-white text-slate-800 antialiased min-h-screen flex flex-col">

    <header class="bg-slate-900 text-white sticky top-0 z-10 shadow-md">
      <nav class="max-w-5xl mx-auto px-6 flex items-center justify-between h-16">
        <a href="/" class="font-semibold text-lg tracking-tight text-white hover:text-indigo-300 transition-colors">
          {personal.name}
        </a>
        <ul class="flex gap-6 text-sm font-medium">
          {nav.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class:list={[
                  'transition-colors hover:text-indigo-300',
                  currentPath === href || (href !== '/' && currentPath.startsWith(href))
                    ? 'text-indigo-400'
                    : 'text-slate-300',
                ]}
                target={href.startsWith('http') ? '_blank' : undefined}
                rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="bg-slate-900 text-slate-400 mt-24">
      <div class="max-w-5xl mx-auto px-6 py-10 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm">
        <p>&copy; {new Date().getFullYear()} {personal.name}</p>
        <div class="flex gap-5">
          {personal.social.github && (
            <a href={personal.social.github} class="hover:text-white transition-colors" target="_blank" rel="noopener noreferrer">GitHub</a>
          )}
          {personal.social.linkedin && (
            <a href={personal.social.linkedin} class="hover:text-white transition-colors" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          )}
          <a href={`mailto:${personal.email}`} class="hover:text-white transition-colors">Email</a>
        </div>
      </div>
    </footer>

    {onboardingRequired && !disableOnboardingRedirect && (
      <script is:inline>
        const adminOnboarding = new URL({JSON.stringify(adminOnboardingUrl)});
        adminOnboarding.searchParams.set('return_to', window.location.href);
        window.location.replace(adminOnboarding.toString());
      </script>
    )}

  </body>
</html>
