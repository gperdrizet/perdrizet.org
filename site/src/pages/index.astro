---
import Layout from '../layouts/Layout.astro';
import { getConfig } from '../lib/config';
import { getCollectionBySlug, getFeaturedProjects, resolveCollectionProjects } from '../lib/projects';

const config = getConfig();
const { personal, bio } = config;
const featured = getFeaturedProjects().slice(0, 6);
const homeSections = (config.home_sections ?? [])
  .map((section) => {
    const collection = getCollectionBySlug(section.collection);
    if (!collection) {
      return null;
    }
    return {
      ...section,
      collection,
      projects: resolveCollectionProjects(collection),
    };
  })
  .filter((section): section is NonNullable<typeof section> => section !== null);

const statusColors: Record<string, string> = {
  live: 'bg-green-100 text-green-700',
  published: 'bg-blue-100 text-blue-700',
  wip: 'bg-amber-100 text-amber-700',
  archived: 'bg-slate-100 text-slate-600',
};
---

<Layout>
  <!-- Hero -->
  <section class="bg-slate-900 text-white py-24">
    <div class="max-w-5xl mx-auto px-6">
      <p class="text-indigo-400 font-medium mb-4 text-sm tracking-widest uppercase">
        {personal.tagline}
      </p>
      <h1 class="text-5xl font-bold mb-6 leading-tight">
        {personal.name}
      </h1>
      <p class="text-slate-300 text-xl max-w-2xl mb-10 leading-relaxed">
        {bio.short}
      </p>
      <div class="flex flex-wrap gap-4">
        <a
          href="/projects"
          class="bg-indigo-600 hover:bg-indigo-500 text-white font-medium px-6 py-3 rounded-lg transition-colors"
        >
          View Projects
        </a>
        <a
          href="/about"
          class="border border-slate-600 hover:border-slate-400 text-slate-300 hover:text-white font-medium px-6 py-3 rounded-lg transition-colors"
        >
          About Me
        </a>
        <a
          href={`mailto:${personal.email}`}
          class="border border-slate-600 hover:border-slate-400 text-slate-300 hover:text-white font-medium px-6 py-3 rounded-lg transition-colors"
        >
          Get in Touch
        </a>
      </div>
    </div>
  </section>

  <!-- Featured Projects -->
  <section class="max-w-5xl mx-auto px-6 py-20">
    <div class="flex items-baseline justify-between mb-10">
      <h2 class="text-2xl font-bold text-slate-900">Featured Projects</h2>
      <a href="/projects" class="text-indigo-600 hover:text-indigo-700 text-sm font-medium transition-colors">
        All projects →
      </a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {featured.map((project) => (
        <a
          href={`/projects/${project.name}`}
          class="group border border-slate-200 rounded-xl p-6 hover:border-indigo-300 hover:shadow-md transition-all flex flex-col"
        >
          <div class="flex items-start justify-between mb-3">
            <h3 class="font-semibold text-slate-900 group-hover:text-indigo-600 transition-colors leading-snug">
              {project.display_name}
            </h3>
            <span class:list={[
              'text-xs font-medium px-2 py-0.5 rounded-full ml-2 shrink-0 mt-0.5',
              statusColors[project.status] ?? 'bg-slate-100 text-slate-600',
            ]}>
              {project.status}
            </span>
          </div>
          <p class="text-sm text-slate-600 leading-relaxed mb-4 flex-1">
            {project.description_short}
          </p>
          <div class="flex flex-wrap gap-1.5">
            {project.tags.slice(0, 4).map((tag) => (
              <span class="text-xs bg-slate-100 text-slate-600 px-2 py-0.5 rounded">
                {tag}
              </span>
            ))}
          </div>
        </a>
      ))}
    </div>
  </section>

  {homeSections.map((section) => (
    <section class="bg-slate-50 border-y border-slate-200">
      <div class="max-w-5xl mx-auto px-6 py-16 flex flex-col sm:flex-row items-start gap-10">
        <div class="flex-1">
          <h2 class="text-xl font-bold text-slate-900 mb-3">
            {section.title ?? section.collection.display_name}
          </h2>
          <p class="text-slate-600 leading-relaxed mb-5">
            {section.summary ?? section.collection.summary ?? section.collection.description_short ?? ''}
          </p>
          <div class="flex flex-wrap gap-2 mb-5">
            {(section.collection.tags ?? []).map((tag) => (
              <span class="text-xs bg-white border border-slate-200 text-slate-600 px-3 py-1 rounded-full">
                {tag}
              </span>
            ))}
          </div>
          {section.projects.length > 0 && (
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {section.projects.slice(0, 4).map((project) => (
                <a
                  href={`/projects/${project.name}`}
                  class="group border border-slate-200 bg-white rounded-lg p-4 hover:border-indigo-300 transition-all"
                >
                  <h3 class="text-sm font-semibold text-slate-900 group-hover:text-indigo-600 transition-colors mb-1">
                    {project.display_name}
                  </h3>
                  <p class="text-xs text-slate-600">{project.description_short}</p>
                </a>
              ))}
            </div>
          )}
        </div>
        <div class="sm:shrink-0 sm:pt-1">
          <a
            href={`/projects/${section.collection.name}`}
            class="inline-block border border-slate-300 hover:border-indigo-400 text-slate-700 hover:text-indigo-600 font-medium px-5 py-2.5 rounded-lg text-sm transition-colors"
          >
            Open collection →
          </a>
        </div>
      </div>
    </section>
  ))}
</Layout>
