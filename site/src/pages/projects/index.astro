---
import Layout from '../../layouts/Layout.astro';
import { getProjects } from '../../lib/projects';
import type { Project } from '../../lib/projects';

const all = getProjects();

// Sort: featured first, then by status priority, then alphabetically
const statusOrder: Record<string, number> = { live: 0, published: 1, wip: 2, archived: 3 };
const projects = [...all].sort((a, b) => {
  if (a.featured && !b.featured) return -1;
  if (!a.featured && b.featured) return 1;
  const sDiff = (statusOrder[a.status] ?? 9) - (statusOrder[b.status] ?? 9);
  if (sDiff !== 0) return sDiff;
  return a.display_name.localeCompare(b.display_name);
});

const statusColors: Record<string, string> = {
  live: 'bg-green-100 text-green-700',
  published: 'bg-blue-100 text-blue-700',
  wip: 'bg-amber-100 text-amber-700',
  archived: 'bg-slate-100 text-slate-600',
};

const statusLabels: Record<string, string> = {
  live: 'Live Service',
  published: 'Published',
  wip: 'In Progress',
  archived: 'Archived',
};
---

<Layout title="Projects">
  <!-- Page header -->
  <section class="bg-slate-900 text-white py-16">
    <div class="max-w-5xl mx-auto px-6">
      <h1 class="text-4xl font-bold mb-3">Projects</h1>
      <p class="text-slate-400 text-lg">
        {projects.length} projects: live services, published tools, and research
      </p>
    </div>
  </section>

  <!-- Projects grid -->
  <section class="max-w-5xl mx-auto px-6 py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map((project) => (
        <a
          href={`/projects/${project.name}`}
          class="group border border-slate-200 rounded-xl p-6 hover:border-indigo-300 hover:shadow-md transition-all flex flex-col"
        >
          <div class="flex items-start justify-between mb-3">
            <h2 class="font-semibold text-slate-900 group-hover:text-indigo-600 transition-colors leading-snug">
              {project.display_name}
            </h2>
            <span class:list={[
              'text-xs font-medium px-2 py-0.5 rounded-full ml-2 shrink-0 mt-0.5',
              statusColors[project.status] ?? 'bg-slate-100 text-slate-600',
            ]}>
              {statusLabels[project.status] ?? project.status}
            </span>
          </div>
          <p class="text-sm text-slate-600 leading-relaxed mb-4 flex-1">
            {project.description_short}
          </p>
          <div class="flex flex-wrap gap-1.5">
            {project.tags.slice(0, 5).map((tag) => (
              <span class="text-xs bg-slate-100 text-slate-600 px-2 py-0.5 rounded">
                {tag}
              </span>
            ))}
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>
