---
import Layout from '../../layouts/Layout.astro';
import { getCollections, getProjects, resolveCollectionProjects, resolveCollectionRepos } from '../../lib/projects';
import type { Collection, Project } from '../../lib/projects';

export function getStaticPaths() {
  const projects = getProjects();
  const collections = getCollections();
  return [
    ...projects.map((project) => ({
      params: { slug: project.name },
      props: { entry: project },
    })),
    ...collections.map((collection) => ({
      params: { slug: collection.name },
      props: { entry: collection },
    })),
  ];
}

interface Props {
  entry: Project | Collection;
}

const { entry } = Astro.props;
const isCollection = entry.kind === 'collection';
const project = !isCollection ? (entry as Project) : null;
const collection = isCollection ? (entry as Collection) : null;
const collectionProjects = collection ? resolveCollectionProjects(collection) : [];
const collectionRepos = collection ? resolveCollectionRepos(collection) : [];

const statusColors: Record<string, string> = {
  live: 'bg-green-100 text-green-700',
  published: 'bg-blue-100 text-blue-700',
  wip: 'bg-amber-100 text-amber-700',
  archived: 'bg-slate-100 text-slate-600',
};

const statusLabels: Record<string, string> = {
  live: 'Live Service',
  published: 'Published',
  wip: 'In Progress',
  archived: 'Archived',
};

const description = isCollection
  ? (collection?.description_long?.trim() || collection?.summary || collection?.description_short || '')
  : (project?.description_long?.trim() || project?.description_short || '');
---

<Layout title={entry.display_name} description={description}>
  <!-- Page header -->
  <section class="bg-slate-900 text-white py-16">
    <div class="max-w-5xl mx-auto px-6">
      <a href="/projects" class="text-slate-400 hover:text-indigo-300 text-sm transition-colors mb-6 inline-block">
        ← All projects
      </a>
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <h1 class="text-4xl font-bold">{entry.display_name}</h1>
        {!isCollection && project && (
          <span class:list={[
            'text-sm font-medium px-3 py-1 rounded-full',
            statusColors[project.status] ?? 'bg-slate-100 text-slate-600',
          ]}>
            {statusLabels[project.status] ?? project.status}
          </span>
        )}
      </div>
      {!isCollection && project && (
        <div class="flex flex-wrap gap-3 mt-6">
          {project.github && (
            <a
              href={project.github}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 text-sm border border-slate-700 hover:border-slate-500 text-slate-300 hover:text-white px-4 py-2 rounded-lg transition-colors"
            >
              GitHub →
            </a>
          )}
          {project.service_url && (
            <a
              href={project.service_url}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 text-sm bg-indigo-600 hover:bg-indigo-500 text-white px-4 py-2 rounded-lg transition-colors"
            >
              Live Service →
            </a>
          )}
          {project.package_url && (
            <a
              href={project.package_url}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 text-sm border border-slate-700 hover:border-slate-500 text-slate-300 hover:text-white px-4 py-2 rounded-lg transition-colors"
            >
              Package →
            </a>
          )}
        </div>
      )}
    </div>
  </section>

  <!-- Content -->
  <section class="max-w-5xl mx-auto px-6 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">

      <div class="lg:col-span-2 space-y-10">

        <div>
          <h2 class="text-lg font-semibold text-slate-900 mb-4">About</h2>
          <p class="text-slate-600 leading-relaxed">{description}</p>
        </div>

        {!isCollection && project && project.highlights && project.highlights.length > 0 && (
          <div>
            <h2 class="text-lg font-semibold text-slate-900 mb-4">Key Highlights</h2>
            <ul class="space-y-3">
              {project.highlights.map((h) => (
                <li class="flex gap-3 text-slate-600 leading-relaxed">
                  <span class="text-indigo-500 mt-1 shrink-0">▸</span>
                  <span>{h}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        {!isCollection && project && project.teaching_context && (
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-6">
            <h2 class="text-lg font-semibold text-slate-900 mb-3">Teaching Context</h2>
            <p class="text-slate-600 leading-relaxed">{project.teaching_context}</p>
          </div>
        )}

        {isCollection && collection && (collectionProjects.length > 0 || collectionRepos.length > 0) && (
          <div>
            <h2 class="text-lg font-semibold text-slate-900 mb-4">Members</h2>
            <div class="space-y-3">
              {collectionProjects.map((memberProject) => (
                <a
                  href={`/projects/${memberProject.name}`}
                  class="block border border-slate-200 rounded-lg p-4 hover:border-indigo-300 transition-all"
                >
                  <h3 class="font-semibold text-slate-900 mb-1">{memberProject.display_name}</h3>
                  <p class="text-sm text-slate-600">{memberProject.description_short}</p>
                </a>
              ))}
              {collectionRepos.map((memberRepo) => {
                const href = memberRepo.url ?? `https://github.com/${memberRepo.repo}`;
                return (
                  <a
                    href={href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="block border border-slate-200 rounded-lg p-4 hover:border-indigo-300 transition-all"
                  >
                    <h3 class="font-semibold text-slate-900 mb-1">{memberRepo.label ?? memberRepo.repo}</h3>
                    <p class="text-sm text-slate-600">Repository member</p>
                  </a>
                );
              })}
            </div>
          </div>
        )}

      </div>

      <div class="space-y-8">

        {(isCollection ? (collection?.tags ?? []).length > 0 : project && project.tags.length > 0) && (
          <div>
            <h3 class="text-sm font-semibold text-slate-500 uppercase tracking-wide mb-3">Technologies</h3>
            <div class="flex flex-wrap gap-2">
              {(isCollection ? collection?.tags ?? [] : project?.tags ?? []).map((tag) => (
                <span class="text-sm bg-slate-100 text-slate-700 px-3 py-1 rounded-full">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        )}

        {(isCollection ? (collection?.roles ?? []).length > 0 : project && project.roles.length > 0) && (
          <div>
            <h3 class="text-sm font-semibold text-slate-500 uppercase tracking-wide mb-3">Roles</h3>
            <div class="flex flex-wrap gap-2">
              {(isCollection ? collection?.roles ?? [] : project?.roles ?? []).map((role) => (
                <span class="text-sm border border-indigo-200 text-indigo-700 bg-indigo-50 px-3 py-1 rounded-full">
                  {role}
                </span>
              ))}
            </div>
          </div>
        )}

      </div>
    </div>
  </section>
</Layout>
