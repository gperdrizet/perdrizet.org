---
import Layout from '../layouts/Layout.astro';
import { getConfig } from '../lib/config';
import { getCollections, resolveCollectionProjects } from '../lib/projects';

const config = getConfig();
const { personal, bio } = config;

const bioText = bio.long?.trim() ? bio.long : bio.short;
const teachingCollections = getCollections().filter((c) => c.type === 'teaching');
---

<Layout title="About">
  <!-- Page header -->
  <section class="bg-slate-900 text-white py-16">
    <div class="max-w-5xl mx-auto px-6">
      <h1 class="text-4xl font-bold mb-3">About</h1>
      <p class="text-slate-400 text-lg">{personal.tagline}</p>
    </div>
  </section>

  <div class="max-w-5xl mx-auto px-6 py-16 space-y-16">

    <!-- Bio -->
    <section class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      <div class="lg:col-span-2">
        <h2 class="text-2xl font-bold text-slate-900 mb-5">Background</h2>
        <p class="text-slate-600 leading-relaxed text-lg">{bioText}</p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href="/projects"
            class="bg-indigo-600 hover:bg-indigo-500 text-white font-medium px-5 py-2.5 rounded-lg text-sm transition-colors"
          >
            View Projects
          </a>
          <a
            href="/contact"
            class="border border-slate-300 hover:border-indigo-400 text-slate-700 hover:text-indigo-600 font-medium px-5 py-2.5 rounded-lg text-sm transition-colors"
          >
            Get in Touch
          </a>
        </div>
      </div>
      <div>
        <h3 class="text-sm font-semibold text-slate-500 uppercase tracking-wide mb-4">Connect</h3>
        <ul class="space-y-3 text-sm">
          {personal.social.github && (
            <li>
              <a href={personal.social.github} target="_blank" rel="noopener noreferrer" class="text-indigo-600 hover:text-indigo-700 transition-colors">
                GitHub →
              </a>
            </li>
          )}
          {personal.social.linkedin && (
            <li>
              <a href={personal.social.linkedin} target="_blank" rel="noopener noreferrer" class="text-indigo-600 hover:text-indigo-700 transition-colors">
                LinkedIn →
              </a>
            </li>
          )}
          <li>
            <a href={`mailto:${personal.email}`} class="text-indigo-600 hover:text-indigo-700 transition-colors">
              {personal.email}
            </a>
          </li>
        </ul>
      </div>
    </section>

    {teachingCollections.map((collection) => {
      const teachingProjects = resolveCollectionProjects(collection);
      return (
        <section class="border-t border-slate-200 pt-16">
          <h2 class="text-2xl font-bold text-slate-900 mb-5">{collection.display_name}</h2>
          {(collection.summary || collection.description_short) && (
            <p class="text-slate-600 leading-relaxed mb-8 max-w-2xl">
              {collection.summary ?? collection.description_short}
            </p>
          )}

          {collection.topics && collection.topics.length > 0 && (
            <div class="mb-8">
              <h3 class="text-sm font-semibold text-slate-500 uppercase tracking-wide mb-4">Topics</h3>
              <div class="flex flex-wrap gap-2">
                {collection.topics.map((topic) => (
                  <span class="text-sm bg-white border border-slate-200 text-slate-700 px-4 py-1.5 rounded-full">
                    {topic}
                  </span>
                ))}
              </div>
            </div>
          )}

          {collection.platforms && collection.platforms.length > 0 && (
            <div>
              <h3 class="text-sm font-semibold text-slate-500 uppercase tracking-wide mb-4">Platforms</h3>
              <div class="flex flex-wrap gap-2">
                {collection.platforms.map((platform) => (
                  <span class="text-sm bg-indigo-50 border border-indigo-200 text-indigo-700 px-4 py-1.5 rounded-full">
                    {platform}
                  </span>
                ))}
              </div>
            </div>
          )}

          {teachingProjects.length > 0 && (
            <div class="mt-10">
              <h3 class="text-sm font-semibold text-slate-500 uppercase tracking-wide mb-4">Related Projects</h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                {teachingProjects.map((p) => (
                  <a
                    href={`/projects/${p.name}`}
                    class="group border border-slate-200 rounded-xl p-5 hover:border-indigo-300 hover:shadow-sm transition-all"
                  >
                    <h4 class="font-semibold text-slate-900 group-hover:text-indigo-600 transition-colors mb-1">
                      {p.display_name}
                    </h4>
                    <p class="text-sm text-slate-600 leading-relaxed">{p.description_short}</p>
                  </a>
                ))}
              </div>
            </div>
          )}
        </section>
      );
    })}

  </div>
</Layout>
