---
import Layout from '../layouts/Layout.astro';
import { getConfig } from '../lib/config';

const config = getConfig();
const { personal } = config;

const links = [
  {
    label: 'Email',
    href: `mailto:${personal.email}`,
    value: personal.email,
    description: 'Best for project inquiries and collaboration',
    external: false,
  },
  ...(personal.social.github ? [{
    label: 'GitHub',
    href: personal.social.github,
    value: personal.social.github.replace('https://', ''),
    description: 'Source code, projects, and open-source work',
    external: true,
  }] : []),
  ...(personal.social.linkedin ? [{
    label: 'LinkedIn',
    href: personal.social.linkedin,
    value: personal.social.linkedin.replace('https://www.', '').replace('https://', ''),
    description: 'Professional profile and career history',
    external: true,
  }] : []),
  ...(personal.social.bluesky ? [{
    label: 'Bluesky',
    href: personal.social.bluesky,
    value: personal.social.bluesky.replace('https://', ''),
    description: 'AI/ML thoughts and updates',
    external: true,
  }] : []),
  ...(personal.social.substack ? [{
    label: 'Substack',
    href: personal.social.substack,
    value: personal.social.substack.replace('https://', ''),
    description: 'Writing and long-form posts',
    external: true,
  }] : []),
].filter(Boolean);
---

<Layout title="Contact">
  <!-- Page header -->
  <section class="bg-slate-900 text-white py-16">
    <div class="max-w-5xl mx-auto px-6">
      <h1 class="text-4xl font-bold mb-3">Contact</h1>
      <p class="text-slate-400 text-lg">Reach out for collaboration, questions, or just to say hello.</p>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-6 py-16">
    <div class="max-w-2xl">
      <p class="text-slate-600 leading-relaxed mb-12 text-lg">
        I'm open to interesting projects, consulting work, teaching opportunities,
        and conversations about AI/ML engineering. Email is best for anything substantive.
      </p>

      <div class="space-y-4">
        {links.map((link) => (
          <a
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
            class="group flex items-start justify-between border border-slate-200 rounded-xl px-6 py-5 hover:border-indigo-300 hover:shadow-sm transition-all"
          >
            <div>
              <p class="font-semibold text-slate-900 group-hover:text-indigo-600 transition-colors mb-0.5">
                {link.label}
              </p>
              <p class="text-sm text-slate-500">{link.description}</p>
            </div>
            <div class="text-right shrink-0 ml-4">
              <p class="text-sm text-slate-600 group-hover:text-indigo-600 transition-colors">{link.value}</p>
              <p class="text-xs text-slate-400 mt-0.5">{link.external ? 'external ↗' : '→'}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
